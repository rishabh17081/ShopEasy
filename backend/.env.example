# PayPal API Credentials
# Obtain these from the PayPal Developer Dashboard
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal Webhook Configuration
# The URL where PayPal will send webhook events
PAYPAL_WEBHOOK_URL=https://yourdomain.com/api/webhooks/paypal

# Logging Configuration
# Set the logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///ecommerce.db

# JWT Secret Key for Authentication
JWT_SECRET_KEY=your_secure_random_secret_key_here

# Optional: PayPal Environment
# Use 'sandbox' for testing, 'live' for production
PAYPAL_ENVIRONMENT=sandbox
